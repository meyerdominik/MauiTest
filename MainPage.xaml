<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiTest.MainPage"
    Title="Popup ownership reproduction">
    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16"
            MaximumWidthRequest="720"
            HorizontalOptions="Center">
            <Label
                Text="Popup shape and shadow ownership"
                FontSize="24"
                SemanticProperties.HeadingLevel="Level1" />
            <Label
                x:Name="EnvironmentLabel"
                FontSize="14" />
            <Label
                Text="Choose an options mode, open popup A, then open popup B from A. Both popups show the actual shape/shadow ownership. Close B to inspect A again."
                FontSize="16" />
            <Picker
                x:Name="ModePicker"
                Title="Popup options mode"
                AutomationId="OptionsMode"
                SelectedIndex="0">
                <Picker.Items>
                    <x:String>Separate new PopupOptions (default)</x:String>
                    <x:String>PopupOptions.Empty</x:String>
                    <x:String>Omitted options</x:String>
                    <x:String>Fresh shape and shadow (workaround)</x:String>
                </Picker.Items>
            </Picker>
            <Button
                x:Name="OpenButton"
                Text="Open popup A"
                AutomationId="OpenPopupA"
                MinimumHeightRequest="48"
                Clicked="OnOpenClicked" />
            <Label
                Text="Expected: A and B each keep their own shape/shadow parent. The first three modes reproduce sharing; the workaround preserves ownership."
                FontSize="16" />
            <Label
                Text="Results"
                FontSize="20"
                SemanticProperties.HeadingLevel="Level2" />
            <Label
                x:Name="ReportLabel"
                Text="No run yet."
                AutomationId="OwnershipReport"
                FontSize="14"
                LineBreakMode="WordWrap" />
            <Button
                Text="Copy results"
                AutomationId="CopyResults"
                MinimumHeightRequest="48"
                Clicked="OnCopyClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
